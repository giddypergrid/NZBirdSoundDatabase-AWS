# DjangoProject AWS environment variables
#
# ECS injects real values at task start. Store secrets such as
# DJANGO_SECRET_KEY and DB_PASSWORD in AWS Secrets Manager.

# Core Django
DJANGO_SECRET_KEY=replace-me-in-secrets-manager
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=your-alb-dns-name.amazonaws.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# RDS PostgreSQL
DB_NAME=birdsound
DB_USER=bird
DB_PASSWORD=replace-me-in-secrets-manager
DB_HOST=your-rds-endpoint.amazonaws.com
DB_PORT=5432
DB_CONN_MAX_AGE=60

# EFS-mounted data/artifacts
MATERIALS_PREP_DIR=/mnt/artifacts/seed
BIRD_CLASSIFY_DIR=/mnt/artifacts/BirdClassify
BIRD_TEXT_TRAINING_DIR=/mnt/artifacts/birdTextTraining

# Runtime tuning
LOG_FORMAT=json
LOG_LEVEL=INFO
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
MAX_CLASSIFY_AUDIO_BYTES=5242880
BIRD_LIST_MAX_QUANTITY=100
MIN_FREE_MEMORY_BYTES=268435456
TRAFFIC_GUARD_ENABLED=true
MAX_IN_FLIGHT_REQUESTS=30
TRAFFIC_GUARD_RETRY_AFTER_SECONDS=5
TRAFFIC_GUARD_PATH_LIMITS=/birds/api/classify/=1,/birds/api/search-by-description/=2
PRELOAD_SEMANTIC_SEARCH=true
PRELOAD_CLASSIFIER=true
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
